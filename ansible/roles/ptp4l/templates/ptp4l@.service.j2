# PTP4L systemd service for {{ ptp4l_instance_name }}
# Generated by Ansible - do not edit manually

[Unit]
Description=PTP4L time synchronization on {{ ptp4l_instance_name }}
Documentation=man:ptp4l(8)
After=network.target

[Service]
Type=simple
ExecStart=/usr/sbin/ptp4l \
    -f {{ ptp4l_config_file }} \
{% for iface in ptp4l_interfaces %}
    -i {{ iface }} \
{% endfor %}
    --uds_address {{ ptp4l_uds_dir }}/ptp4l@{{ ptp4l_instance_name }} \
{% if ptp4l_mode == 'server' %}
    --serverOnly=1
{% else %}
    --clientOnly=1
{% endif %}
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
