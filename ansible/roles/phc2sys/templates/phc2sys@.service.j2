# PHC2SYS systemd service for {{ phc2sys_instance_name }}
# Generated by Ansible - do not edit manually

[Unit]
Description=PHC2SYS clock synchronization for {{ phc2sys_instance_name }}
Documentation=man:phc2sys(8)
After=network.target{% if phc2sys_ptp4l_uds != "" %} ptp4l@{{ phc2sys_instance_name }}.service{% endif %}

{% if phc2sys_ptp4l_uds != "" %}
Wants=ptp4l@{{ phc2sys_instance_name }}.service
{% endif %}

[Service]
Type=simple
ExecStart=/usr/sbin/phc2sys \
    -s {{ phc2sys_source }} \
{% for dest in phc2sys_destinations %}
    -c {{ dest }} \
{% endfor %}
    -O {{ phc2sys_utc_offset | default(0) }}{% if phc2sys_wait_for_ptp %} \
    -w {% endif %}{% if phc2sys_ptp4l_uds != "" %} \
    -u {{ phc2sys_ptp4l_uds }}{% endif %}

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
