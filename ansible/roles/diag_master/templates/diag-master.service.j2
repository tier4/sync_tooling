# SYNC.TOOLING Diagnostic Master systemd service
# Generated by Ansible - do not edit manually

[Unit]
Description=SYNC.TOOLING Diagnostic Master
Documentation=https://github.com/tier4/sync_tooling
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c '\
    source {{ diag_master_ros_setup_script }} && \
    {{ diag_master_venv_path }}/bin/diag-master \
        --topic {{ diag_master_topic }} \
        --config-files {{ diag_master_config_file }} \
        --update-expiry-s {{ diag_master_update_expiry_s }} \
{% if diag_master_enable_web_ui %}
        --web-ui \
{% endif %}
{% if diag_master_ros_args %}
        --ros-args {% for arg in diag_master_ros_args %}{{ arg }} {% endfor %}\
{% endif %}
'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
