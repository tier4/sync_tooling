# SYNC.TOOLING Diagnostic Worker systemd service
# Generated by Ansible - do not edit manually

[Unit]
Description=SYNC.TOOLING Diagnostic Worker
Documentation=https://github.com/tier4/sync_tooling
After=network.target{% for unit in diag_worker_ptp4l_units %} {{ unit }}.service{% endfor %}{% for unit in diag_worker_phc2sys_units %} {{ unit }}.service{% endfor %}

{% if diag_worker_ptp4l_units or diag_worker_phc2sys_units %}
Requires={% for unit in diag_worker_ptp4l_units %}{{ unit }}.service {% endfor %}{% for unit in diag_worker_phc2sys_units %}{{ unit }}.service {% endfor %}

{% endif %}
[Service]
Type=simple
ExecStart=/bin/bash -c '\
    source {{ diag_worker_ros_setup_script }} && \
    {{ diag_worker_venv_path }}/bin/diag-worker \
        --topic {{ diag_worker_topic }} \
{% if diag_worker_ptp4l_units %}
        --ptp4l-units {% for unit in diag_worker_ptp4l_units %}{{ unit }} {% endfor %}\
{% endif %}
{% if diag_worker_phc2sys_units %}
        --phc2sys-units {% for unit in diag_worker_phc2sys_units %}{{ unit }} {% endfor %}\
{% endif %}
{% if diag_worker_ros_args %}
        --ros-args {% for arg in diag_worker_ros_args %}{{ arg }} {% endfor %}\
{% endif %}
'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
